### Django settings ###
DEBUG=0    # 1 for dev, 0 for prod
ADMIN_ENABLED=0    # Enable Django admin interface. Defaults to DEBUG value if not set. Set to 1 to enable, 0 to disable.
SECRET_KEY=CHANGEME # Generate a long random string of characters for this. Example command: openssl rand -base64 64
SHIFTER_URL=https://shifter.mydomain.com # The URL of your Shifter instance. Include protocol and port if not standard.
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_LOCATION=/var/log/shifter.log
TIMEZONE=UTC

### Timeout settings ###
UPLOAD_TIMEOUT=300  # Timeout in seconds for each upload request (one chunk) sent by the browser. Default is 300 (5 minutes).
UPLOAD_CHUNK_SIZE=8388608  # Uploads are sent in chunks of this many bytes. Default is 8388608 (8MB). Keep it below any reverse proxy request body limit.
CHUNKED_UPLOAD_MAX_AGE_HOURS=24  # Unfinished uploads not touched for this many hours are deleted by the cleanup job. Default is 24.
TASK_RESULT_MAX_AGE_DAYS=7  # Finished background task records older than this many days are deleted daily. Default is 7.
GUNICORN_TIMEOUT=600  # Gunicorn worker timeout in seconds. Default is 600 (10 minutes). Should be >= UPLOAD_TIMEOUT.
GUNICORN_WORKERS=2  # Number of Gunicorn worker processes. Default is 2.
GUNICORN_THREADS=8  # Threads per Gunicorn worker. Each request in progress (e.g. a download) uses one thread, so workers x threads is how many can run at once. Default is 8.
RUN_TASK_WORKER=1  # Run the background task worker (file hashing) inside this container. Set to 0 if you run `python manage.py db_worker` in a separate container. Default is 1.
# X_ACCEL_REDIRECT_PREFIX=/protected-media/  # Uncomment to let your reverse proxy send downloaded files. Only set this once the proxy is configured, see docs/PROXY_DOWNLOADS.md.

### Database settings ###
DATABASE=sqlite  # Possible values: sqlite, postgres

# The following only need to be set if you choose postgres. They can be ignored if you choose sqlite.
# Don't forget to add a postgres container to your docker-compose.yml file if you choose postgres.
SQL_DATABASE=CHANGEME
SQL_USER=CHANGEME
SQL_PASSWORD=CHANGEME
SQL_HOST=db
SQL_PORT=5432

# Config for postgres db container - should match credentials above. You can usually ignore this, even if you choose postgres.
POSTGRES_DB=${SQL_DATABASE}
POSTGRES_USER=${SQL_USER}
POSTGRES_PASSWORD=${SQL_PASSWORD}
PGDATA=/var/lib/postgresql/data/